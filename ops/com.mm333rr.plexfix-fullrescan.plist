<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mm333rr.plexfix-fullrescan</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/usr/local/bin/python3</string>
        <string>/Users/mProAdmin/Claude Scripts and Venvs/plex-batch-optimizer/watcher.py</string>
        <string>--full-rescan</string>
        <string>--paths</string>
        <string>/Volumes/tv</string>
        <string>/Volumes/movies</string>
        <string>/Volumes/adult</string>
        <string>--boot-grace</string>
        <string>0</string>
        <string>--max-jobs-per-run</string>
        <string>100000</string>
        <string>--inter-job-sleep</string>
        <string>5</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/mProAdmin/Claude Scripts and Venvs/plex-batch-optimizer/results/fullrescan_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mProAdmin/Claude Scripts and Venvs/plex-batch-optimizer/results/fullrescan_stderr.log</string>
</dict>
</plist>
